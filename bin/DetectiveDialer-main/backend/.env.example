# ─────────────────────────────────────────────────────────────
#  Detective Dialer Backend — Environment Configuration
#  Copy this file to `.env` and fill in your own values.
# ─────────────────────────────────────────────────────────────

# Server
PORT=3000
# Public base URL of this server once deployed.
# Example: https://your-app.up.railway.app
PUBLIC_BASE_URL=http://localhost:3000

# Shared secret between this server and the Android app. When set, /screen and
# /api/* require a matching X-Api-Key header; when empty, auth is disabled.
# Generate one with: openssl rand -hex 24
API_KEY=

# ── Google Gemini ────────────────────────────────────────────
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Model used to classify incoming numbers (text classification).
# Evergreen alias — pinned models (e.g. gemini-1.5-flash) get retired and 404.
GEMINI_MODEL=gemini-flash-lite-latest
# Max time Gemini may take before falling back to heuristics (the phone only
# waits ~5s total for a screening verdict).
GEMINI_TIMEOUT_MS=2500

# ── Firebase Cloud Messaging (push notifications) ────────────
# Path to a service account JSON, OR paste the JSON into FIREBASE_SERVICE_ACCOUNT_JSON.
# Generate at: Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Fallback FCM token only — the app now registers its token automatically via
# POST /api/device (and re-registers when Firebase rotates it), so this can
# normally stay empty.
FCM_DEFAULT_DEVICE_TOKEN=

# ── Call owner / personalization ─────────────────────────────
# Used to frame the screening prompt ("screening calls on behalf of <name>").
OWNER_NAME=the owner

# ── Screening behaviour ──────────────────────────────────────
# Auto-block a number after this many SPAM classifications.
SPAM_AUTOBLOCK_THRESHOLD=3
