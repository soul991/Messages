<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      V2-44: Android 12+ dynamic palette. The widget sits on the user's
      wallpaper next to the launcher's own widgets, so borrowing the system
      neutrals is what makes it look like it belongs there. The static values
      in values/ remain the fallback below 31, where these attrs don't exist.
    -->
    <color name="widget_background">@android:color/system_neutral1_50</color>
    <color name="widget_text_primary">@android:color/system_neutral1_900</color>
    <color name="widget_text_secondary">@android:color/system_neutral2_700</color>
    <color name="widget_text_tertiary">@android:color/system_neutral2_500</color>
</resources>
